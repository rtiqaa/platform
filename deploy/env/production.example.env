# =====================================================================
# RTIQA Education Platform - Production Environment Variables Template
# Inject these variables into Cloud Run via Google Secret Manager / Cloud Run Env
# NEVER commit actual passwords, secret tokens, or private keys to git.
# =====================================================================

# ----------------- 1. MANDATORY RUNTIME CONFIGURATION -----------------
NODE_ENV="production"
PORT="3000"
APP_URL="https://rtiqa.com"

# ----------------- 2. SUPABASE POSTGRESQL -----------------
# Runtime requests use Supavisor's session/transaction pooler connection.
# Use the pooler URL shown in Supabase Dashboard > Connect, with SSL enabled.
DATABASE_URL="postgresql://postgres.PROJECT_REF:REPLACE_WITH_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# Production migrations require a direct Supabase database connection.
# Keep this secret server-side; never expose it to browser or Android clients.
DIRECT_DATABASE_URL="postgresql://postgres:REPLACE_WITH_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Connection pool size per Cloud Run container instance (Max 20 per instance)
PGMAX_POOL="20"

# ----------------- 3. PRODUCTION AUTHENTICATION -----------------
# 64+ character cryptographically random string generated via `openssl rand -base64 48`
AUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_BASE64_48_STRING"

# ----------------- 4. OBJECT STORAGE (CLOUDFLARE R2) -----------------
STORAGE_PROVIDER="s3"
S3_ENDPOINT="https://REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="rtiqa-production-storage"
S3_ACCESS_KEY_ID="REPLACE_WITH_R2_ACCESS_KEY_ID"
S3_SECRET_ACCESS_KEY="REPLACE_WITH_R2_SECRET_ACCESS_KEY"
S3_FORCE_PATH_STYLE="false"
STORAGE_URL_TTL="900"
STORAGE_MAX_BYTES="52428800"

# ----------------- 5. THIRD-PARTY & INTEGRATIONS -----------------
# Transactional Email (Amazon SES / SendGrid / Resend / Postmark / SMTP)
SMTP_HOST="smtp.mailprovider.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="REPLACE_WITH_SMTP_USERNAME"
SMTP_PASS="REPLACE_WITH_SMTP_PASSWORD"
SMTP_FROM="Rtiqa Platform <no-reply@rtiqa.com>"

# Gemini AI Platform API Key (Server-side only)
GEMINI_API_KEY="REPLACE_WITH_GEMINI_API_KEY"

# Contact / Demo Inquiries Webhook
FORM_WEBHOOK_URL="https://webhook.site/REPLACE_OR_LEAVE_EMPTY"
